# Переменные окружения для api/send-order.js (заявка на расчёт из корзины).
# Скопируйте файл в .env.local (для vercel dev) и заполните своими значениями —
# .env.local уже в .gitignore, в репозиторий он не попадёт. На проде (Vercel)
# те же переменные задаются в Project Settings → Environment Variables, а не
# файлом — там .env.local никто не читает.

# --- SMTP-сервер, с которого сайт отправляет письма -------------------------
# Ниже — настройки для Gmail. Как получить пароль приложения:
#   1. Включите двухфакторную аутентификацию на аккаунте Google, который
#      будет отправлять письма (Google-аккаунт → Безопасность → Пароли
#      приложений; без 2FA пункт не появится).
#   2. Google-аккаунт → Безопасность → Пароли приложений → создайте пароль
#      для приложения "Почта" / "Other" — Google выдаст 16 символов вида
#      "abcd efgh ijkl mnop". Обычный пароль от аккаунта тут не подойдёт.
#   3. Впишите этот 16-символьный пароль в SMTP_PASS без пробелов.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-16-char-app-password

# Альтернатива — Яндекс.Почта (тоже нужен пароль приложения, а не обычный):
#   Настройки Яндекс.Почты → Все настройки → Безопасность → Пароли приложений.
# SMTP_HOST=smtp.yandex.by
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-address@yandex.by
# SMTP_PASS=your-app-password

# --- Куда падают заявки ------------------------------------------------------
# Не обязана совпадать с SMTP_USER: можно слать письма через один ящик,
# а получать — на другой (например, общий адрес отдела продаж).
ADMIN_EMAIL=vps.kirzis@gmail.com
